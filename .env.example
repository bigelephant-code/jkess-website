# Google Analytics (optional; GA only loads when this is set)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Site URL (used in structured data, sitemap, robots, and OG tags)
NEXT_PUBLIC_SITE_URL=https://www.jkesstech.com

# Search engine ownership verification (optional)
# Paste the exact verification content values from Google Search Console and Bing Webmaster Tools.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Bing / IndexNow URL notification (optional)
# The default key is hosted at /indexnow-key.txt.
INDEXNOW_KEY=0a413e2f4f0550ba613c42a081b9a567
INDEXNOW_KEY_LOCATION=
INDEXNOW_SUBMIT_SECRET=
INDEXNOW_ENDPOINT=https://api.indexnow.org/indexnow

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production

# Transactional email (Resend)
RESEND_API_KEY=your-resend-api-key
ORDER_EMAIL_FROM="JKESS Orders <orders@example.com>"
ORDER_NOTIFICATION_EMAIL=zhou@jkess.com
ORDER_TEST_SECRET=your-private-test-secret

# Paid-order and inventory persistence (Upstash Redis)
UPSTASH_REDIS_REST_URL=your-upstash-rest-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# Supported fallback names: KV_REST_API_URL and KV_REST_API_TOKEN

# PayPal checkout
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_ENVIRONMENT=live
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
